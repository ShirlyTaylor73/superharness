# Ensure shell scripts always have LF line endings
*.sh text eol=lf
hooks/session-start text eol=lf

# Extensionless bash wrappers under plugins/*/hooks/ (workflow-context,
# workflow-pre-tool-use, workflow-stop, workflow-post-transition).
# Pattern is suffix-anchored so we don't accidentally hit dotfiles.
plugins/*/hooks/workflow-* text eol=lf

# Ensure the polyglot wrapper keeps LF (it's parsed by both cmd and bash)
*.cmd text eol=lf

# Common text files
*.md text eol=lf
*.json text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf

# Explicitly mark binary files
*.png binary
*.jpg binary
*.gif binary
